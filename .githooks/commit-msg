#!/usr/bin/env bash
#
# Reject AI-agent trailers and session links in commit messages.
#
# Reference implementation. Copy into a consuming repo as .githooks/commit-msg
# and install with: git config core.hooksPath .githooks
#
# Rule: standards/GIT.md, "Authorship".
#
set -euo pipefail

msg_file="$1"

# Strip comment lines git adds to the template before matching.
body="$(grep -v '^#' "$msg_file" || true)"

if printf '%s\n' "$body" | grep -qiE '^[[:space:]]*Co-Authored-By:.*(claude|copilot|cursor|codex|gpt|gemini|anthropic|openai|assistant|\bbot\b)'; then
  echo "commit-msg: AI-agent Co-Authored-By trailer is not allowed." >&2
  echo "            Commits carry the identity declared in AGENTS.md. See standards/GIT.md 'Authorship'." >&2
  exit 1
fi

# Anchored to line start on purpose. A trailer is a line; an unanchored match
# would also reject a commit that documents this very rule in prose.
if printf '%s\n' "$body" | grep -qiE '^[[:space:]]*(Claude-Session:|Generated with .*(Claude|Copilot|Cursor|Codex)|https?://claude\.ai/code)'; then
  echo "commit-msg: agent session link or 'Generated with ...' footer is not allowed." >&2
  echo "            See standards/GIT.md 'Authorship'." >&2
  exit 1
fi

exit 0
