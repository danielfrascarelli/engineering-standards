#!/usr/bin/env bash
#
# Reject a push whose outgoing commits do not carry the repo's declared git identity.
#
# The declaration is read from AGENTS.md, so the committed declaration stays
# authoritative and the hook cannot drift from it.
#
# Reference implementation. Copy into a consuming repo as .githooks/pre-push
# and install with: git config core.hooksPath .githooks
#
# Rule: standards/GIT.md, "Authorship".
#
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
agents_file="$repo_root/AGENTS.md"

if [[ ! -f "$agents_file" ]]; then
  echo "pre-push: AGENTS.md not found. It must declare the repo git identity." >&2
  echo "          See standards/GIT.md 'Authorship'." >&2
  exit 1
fi

declared_email="$(sed -nE 's/^[[:space:]]*-?[[:space:]]*user\.email:[[:space:]]*(.+)[[:space:]]*$/\1/p' "$agents_file" | head -1)"

if [[ -z "$declared_email" ]]; then
  echo "pre-push: AGENTS.md declares no 'user.email:'. Add a Git identity block." >&2
  echo "          See standards/GIT.md 'Authorship'." >&2
  exit 1
fi

zero="0000000000000000000000000000000000000000"
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue          # branch deletion

  if [[ "$remote_sha" == "$zero" ]]; then
    # New branch: check every commit not already reachable from another remote ref.
    range=("$local_sha" --not --remotes)
  else
    range=("$remote_sha..$local_sha")
  fi

  while read -r sha author_email; do
    [[ -z "$sha" ]] && continue
    if [[ "$author_email" != "$declared_email" ]]; then
      echo "pre-push: ${sha:0:8} authored by <$author_email>, expected <$declared_email>." >&2
      status=1
    fi
  done < <(git log --format='%H %ae' "${range[@]}")

  # Anchored to line start on purpose. A trailer is a line; an unanchored match
  # would also reject a commit that documents this very rule in prose.
  if git log --format='%B' "${range[@]}" | grep -qiE '^[[:space:]]*(Co-Authored-By:.*(claude|copilot|cursor|codex|gpt|gemini|anthropic|openai)|Claude-Session:|Generated with .*(Claude|Copilot|Cursor|Codex)|https?://claude\.ai/code)'; then
    echo "pre-push: an outgoing commit message contains an agent trailer or session link." >&2
    status=1
  fi
done

if [[ "$status" -ne 0 ]]; then
  echo "" >&2
  echo "Fix with: git config user.email '$declared_email' && git rebase -i --exec 'git commit --amend --no-edit --reset-author'" >&2
  echo "See standards/GIT.md 'Authorship'." >&2
fi

exit "$status"
